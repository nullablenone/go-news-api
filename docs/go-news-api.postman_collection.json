            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"muhamad yesa\",\r\n  \"slug\": \"muhamad-yesa\",\r\n  \"summary\": \"LLL ive into constructing high-performance modular APIs. Learn how to separate concerns, implement robust Role-Based Access Control (RBAC), and optimize database performance.\",\r\n  \"category\": \"Architecture & Security\",\r\n  \"read_time\": \"19 min read\",\r\n  \"content\": [\r\n    {\r\n      \"type\": \"paragraph\",\r\n      \"text\": \"LLLLL small, everything seems easy to manage. But as feature requests pile up, files grow longer, and developers step on each other's toes, codebase health degrades. The solution? Clean Architecture.\"\r\n    },\r\n    {\r\n      \"type\": \"paragraph\",\r\n      \"text\": \"Clean Architecture separates code into independent concentric circles, placing core business logic at the center and keeping database schemas, frameworks, and APIs at the periphery.\"\r\n    },\r\n    {\r\n      \"type\": \"heading\",\r\n      \"level\": 2,\r\n      \"text\": \"The Clean Architecture Layering in Go\"\r\n    },\r\n    {\r\n      \"type\": \"list\",\r\n      \"items\": [\r\n        \"Domain/Entities: Defines plain objects and core interfaces.\",\r\n        \"Usecase/Service: Contains business rules and processes.\",\r\n        \"Repository/Delivery: The outer layer implementing actual SQL and HTTP handlers.\"\r\n      ]\r\n    },\r\n    {\r\n      \"type\": \"code\",\r\n      \"language\": \"go\",\r\n      \"code\": \"// domain/user.go\\npackage domain\\n\\ntype User struct {\\n    ID    int64  `json:\\\"id\\\"`\\n    Email string `json:\\\"email\\\"`\\n    Role  string `json:\\\"role\\\"`\\n}\"\r\n    }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
